<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for Symbol P2P ad listings.
 */

/**
 * Implements hook_cron().
 */
function symbol_p2p_ad_listing_cron(): void {
  $repository = \Drupal::service('symbol_p2p_ad_listing.repository');
  $batch_size = symbol_p2p_ad_listing_cron_batch_size();
  $now = \Drupal::time()->getRequestTime();
  $repository->releaseFailedMatches($now, 50);
  foreach ($repository->expirationCandidateIds($now, 50) as $listing_id) {
    $repository->markExpired($listing_id);
  }
  \Drupal::service('symbol_p2p_ad_listing.balance_check_manager')->checkActiveListings($batch_size);
}

function symbol_p2p_ad_listing_cron_batch_size(): int {
  $value = \Drupal::config('symbol_p2p_ad_listing.settings')->get('cron_balance_check_batch_size');
  if (!is_numeric($value)) {
    return 50;
  }
  return max(1, min(500, (int) $value));
}
