<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for Symbol P2P ad listings.
 */

/**
 * Implements hook_cron().
 */
function symbol_p2p_ad_listing_cron(): void {
  $repository = \Drupal::service('symbol_p2p_ad_listing.repository');
  foreach ($repository->expirationCandidateIds(\Drupal::time()->getRequestTime(), 50) as $listing_id) {
    $repository->markExpired($listing_id);
  }
  \Drupal::service('symbol_p2p_ad_listing.balance_check_manager')->checkActiveListings(50);
}
