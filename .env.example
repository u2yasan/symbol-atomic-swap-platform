PROJECT_NAME=symbol-atomic-swap-platform

# Local development defaults only. Do not commit real secrets in .env files.
DRUPAL_PORT=8080
DRUPAL_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=drupal
POSTGRES_USER=drupal
POSTGRES_PASSWORD=drupal
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1

SYMBOL_ENGINE_PORT=3000
SYMBOL_ENGINE_BIND_ADDRESS=127.0.0.1
# Required. Use a high-entropy random value in every non-local environment.
SYMBOL_ENGINE_API_TOKEN=replace-with-at-least-32-random-characters
SYMBOL_ENGINE_DATABASE_URL=postgresql://drupal:drupal@postgres:5432/drupal
SYMBOL_ENGINE_LISTENER_ENABLED=false
SYMBOL_ENGINE_LISTENER_ADDRESSES=
SYMBOL_ENGINE_RECONCILER_ENABLED=false
SYMBOL_ENGINE_RECONCILER_INTERVAL_MS=30000
SYMBOL_ENGINE_EXPOSE_NODE_ENDPOINTS=false
SYMBOL_ENGINE_BASE_URL=http://symbol-engine:3000
SYMBOL_ENGINE_TIMEOUT=10
SYMBOL_NODE_REQUEST_TIMEOUT_MS=10000
SYMBOL_NETWORK=testnet
SYMBOL_NODE_URL=https://sym-test-01.opening-line.jp:3001
SYMBOL_WS_URL=wss://sym-test-01.opening-line.jp:3001/ws
